{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "ibnalazhardocs",
  "compatibility_date": "2026-06-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "ibnalazhardocs",
    },
  ],
  "vars": {
    "QUEUE_DRIVER": "pg",
    "STORAGE_DRIVER": "s3",
    "NODE_ENV": "production",
  },
}
